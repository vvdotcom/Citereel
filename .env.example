# Copy to .env only if you do not already have a private .env.
# Bedrock API key authentication (never use NEXT_PUBLIC_ for a credential).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8011/v1
LAUNCHPAD_WEB_ORIGINS=http://127.0.0.1:3011,http://localhost:3011
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Optional alternative: AWS profile / IAM role. Leave commented for API-key auth.
# AWS_PROFILE=launchpad-dev

# Narration is separate from Bedrock. A Bedrock API key cannot invoke Polly.
# All four video formats use Polly by default, including on Windows.
# Requires AWS profile/role credentials with polly:SynthesizeSpeech permission.
# Optional offline testing only: explicitly set LAUNCHPAD_VOICE=windows.
LAUNCHPAD_VOICE=polly
POLLY_ENGINE=generative
POLLY_FEMALE_VOICE_ID=Ruth
POLLY_MALE_VOICE_ID=Matthew

# Local launcher starts the API, worker and web app; creates an internal secret.
LAUNCHPAD_WEB_PORT=3011
LAUNCHPAD_API_URL=http://127.0.0.1:8011
LAUNCHPAD_LOCAL_MODE=true
LAUNCHPAD_SECURE_COOKIES=false
LAUNCHPAD_DATA_DIR=.launchpad-data
# Cost guardrail: accepted jobs per signed-in user per UTC day.
LAUNCHPAD_DAILY_JOB_LIMIT=20
# Optional shared reviewer sign-in. Keep the password private; the public UI
# calls the API endpoint and never receives these values.
# LAUNCHPAD_JUDGE_DEMO_EMAIL=judge@example.com
# LAUNCHPAD_JUDGE_DEMO_PASSWORD=
# Optional operator restriction; blank permits individually authorized public origins.
LAUNCHPAD_ALLOWED_ORIGINS=

# Optional cloud planner. Normally injected by infra/template.yaml, not set locally.
# Requires the shared DynamoDB store and IAM InvokeAgentRuntime/StopRuntimeSession.
# LAUNCHPAD_AGENTCORE_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT:runtime/RUNTIME_ID
# LAUNCHPAD_DYNAMODB_TABLE=your-launchpad-jobs-table
